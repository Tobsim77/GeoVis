# -----------------------------------------------------------------------------
# 6. Plotly-Colorscale erzeugen
# -----------------------------------------------------------------------------

colorscale <- Map(
  function(pos, col) {
    list(pos, col)
  },
  seq(0, 1, length.out = length(colours)),
  colours
)


# -----------------------------------------------------------------------------
# 7. 3D-Plot
# -----------------------------------------------------------------------------

p3d <- plot_ly(
  x = x,
  y = y,
  z = z_altitude,
  
  # Farbe unabhängig von z:
  surfacecolor = z_slope,
  
  type = "surface",
  
  colorscale = colorscale,
  
  colorbar = list(
    title = "Temperature slope"
  ),
  
  hovertemplate = paste(
    "X: %{x}<br>",
    "Y: %{y}<br>",
    "Altitude: %{z:.0f} m<br>",
    "Slope: %{surfacecolor:.4f}<br>",
    "<extra></extra>"
  )
) |>
  layout(
    scene = list(
      
      xaxis = list(
        title = "X"
      ),
      
      yaxis = list(
        title = "Y"
      ),
      
      zaxis = list(
        title = "Altitude [m]"
      ),
      
      aspectmode = "manual",
      aspectratio = list(
        x = 2,
        y = 1,
        z = .1
      )
    ),
    
    margin = list(
      l = 0,
      r = 0,
      b = 0,
      t = 30
    )
  )


