)
grid <- tibble(
X = coords[, 1],
Y = coords[, 2]
)
n_cells <- nrow(grid)
n <- integer(n_cells)
sum_year <- numeric(n_cells)
sum_TM <- numeric(n_cells)
sum_year2 <- numeric(n_cells)
sum_year_TM <- numeric(n_cells)
}
if (length(TM) != nrow(grid)) {
stop(
paste(
"Grid size changed in year",
yr
)
)
}
valid <- is.finite(TM)
n[valid] <-
n[valid] + 1
sum_year[valid] <-
sum_year[valid] + yr
sum_TM[valid] <-
sum_TM[valid] + TM[valid]
sum_year2[valid] <-
sum_year2[valid] + yr^2
sum_year_TM[valid] <-
sum_year_TM[valid] + yr * TM[valid]
rm(r, TM)
unlink(tmp)
gc()
setTxtProgressBar(pb, i)
}
close(pb)
message("\nCalculating final slopes...")
denominator <-
n * sum_year2 -
sum_year^2
slope <- rep(
NA_real_,
length(n)
)
valid_slope <-
n >= 2 &
denominator != 0
slope[valid_slope] <- (
n[valid_slope] *
sum_year_TM[valid_slope] -
sum_year[valid_slope] *
sum_TM[valid_slope]
) /
denominator[valid_slope]
slopes <- grid |>
mutate(
slope = slope
) |>
filter(
is.finite(slope)
) |>
select(
X,
Y,
slope
)
saveRDS(
slopes,
"slopes.rds"
)
rm(
grid,
n,
sum_year,
sum_TM,
sum_year2,
sum_year_TM,
denominator,
slope,
valid_slope
)
gc()
message("slopes.rds saved.")
runApp()
